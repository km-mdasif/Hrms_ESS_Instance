# ========================================
# MSSQL Database Configuration
# ========================================
# Update these values with your actual database credentials
# Then rename this file from .env.example to .env

# Database Server Details
MSSQL_SERVER=divineserver
MSSQL_DATABASE=hrms
MSSQL_USER=sa
MSSQL_PASSWORD=sql@123
MSSQL_PORT=2439
MSSQL_INSTANCE=SQL2022

# ========================================
# Alternative Examples (uncomment to use)
# ========================================

# For Local SQL Server Express (Windows default)
# MSSQL_SERVER=localhost
# MSSQL_DATABASE=hrms
# MSSQL_USER=sa
# MSSQL_PASSWORD=YourPassword123
# MSSQL_PORT=1433
# MSSQL_INSTANCE=SQLEXPRESS

# For Azure SQL Database
# MSSQL_SERVER=yourserver.database.windows.net
# MSSQL_DATABASE=hrms
# MSSQL_USER=youradmin
# MSSQL_PASSWORD=YourPassword123
# MSSQL_PORT=1433
# MSSQL_INSTANCE=

# ========================================
# JWT Secrets (Authentication)
# ========================================
JWT_ACCESS_SECRET=your-secret-access-key-change-this
JWT_REFRESH_SECRET=your-secret-refresh-key-change-this

# ========================================
# Server Configuration
# ========================================
PORT=5000
NODE_ENV=development

# ========================================
# Optional: API Configuration
# ========================================
# Uncomment if needed for frontend API endpoint configuration
# REACT_APP_API_HOST=localhost
# REACT_APP_API_HTTP_PORT=5000
# REACT_APP_API_HTTPS_PORT=5443
# REACT_APP_API_BASE_URL=http://localhost:5000
